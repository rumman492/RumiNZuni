# Local and production both use PostgreSQL
DATABASE_URL=postgresql://ruminzuni:ruminzuni@127.0.0.1:5432/ruminzuni
PAYLOAD_SECRET=change-this-to-a-long-random-string
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Production (VPS + Docker + PostgreSQL) — copy to .env on the server
# POSTGRES_PASSWORD=pick-a-long-random-password
# PAYLOAD_SECRET=pick-another-long-random-string
# NEXT_PUBLIC_SERVER_URL=https://ruminzuni.com
# PAYLOAD_DB_PUSH=true

# Order notifications (no secrets in code). Defaults stay off.
# Customer WhatsApp confirmation is always a wa.me button using Store settings.
# Set NOTIFY_OUTBOUND_ENABLED=true only after provider credentials are in this file.
# NOTIFY_OUTBOUND_ENABLED=false
# NOTIFY_TIMEOUT_MS=8000
# NOTIFY_STAFF_EMAIL=
# NOTIFY_STAFF_PHONE=
# NOTIFY_STAFF_WHATSAPP=
# NOTIFY_EMAIL_FROM=

# WhatsApp Cloud API: none | log | meta | webhook
# NOTIFY_WHATSAPP_PROVIDER=none
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_CUSTOMER_TEMPLATE_NAME=
# WHATSAPP_CUSTOMER_TEMPLATE_LANG=en
# WHATSAPP_WEBHOOK_URL=

# Email: none | log | resend | webhook
# NOTIFY_EMAIL_PROVIDER=none
# RESEND_API_KEY=
# EMAIL_WEBHOOK_URL=

# SMS: none | log | twilio | webhook
# NOTIFY_SMS_PROVIDER=none
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# SMS_WEBHOOK_URL=
# NOTIFY_WEBHOOK_SECRET=

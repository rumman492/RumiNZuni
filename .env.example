# Local development (SQLite file — do not use this in production)
DATABASE_URL=file:./ruminzuni.db
PAYLOAD_SECRET=change-this-to-a-long-random-string
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Production (VPS + Docker + PostgreSQL) — copy to .env on the server
# POSTGRES_PASSWORD=pick-a-long-random-password
# PAYLOAD_SECRET=pick-another-long-random-string
# NEXT_PUBLIC_SERVER_URL=https://ruminzuni.com
# PAYLOAD_DB_PUSH=true

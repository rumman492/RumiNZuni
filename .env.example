# Copy to .env. Never commit .env.
# Local PostgreSQL (use your own local password, not a production secret):
DATABASE_URL=postgresql://ruminzuni:LOCAL_ONLY_PASSWORD@127.0.0.1:5432/ruminzuni

# Required. Generate: openssl rand -hex 32
PAYLOAD_SECRET=

# Local origin. Production must be https://ruminzuni.com
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional local admin seed (npm run seed). Never use these values in production.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=
# SEED_WHATSAPP=
# SEED_PHONE=
# SEED_EMAIL=
# Sample catalog with photos. Production loads it on boot only when the shop is empty.
# SEED_CATALOG=true

# Production (VPS + Docker) — set all of these to unique values before first boot.
# POSTGRES_PASSWORD=
# PAYLOAD_SECRET=
# NEXT_PUBLIC_SERVER_URL=https://ruminzuni.com
# PAYLOAD_DB_PUSH=false

# Order notifications stay off until real provider credentials are set.
# NOTIFY_OUTBOUND_ENABLED=false
# NOTIFY_TIMEOUT_MS=8000
# NOTIFY_STAFF_EMAIL=
# NOTIFY_STAFF_PHONE=
# NOTIFY_STAFF_WHATSAPP=
# NOTIFY_EMAIL_FROM=

# WhatsApp Cloud API: none | log | meta | webhook
# NOTIFY_WHATSAPP_PROVIDER=none
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_CUSTOMER_TEMPLATE_NAME=
# WHATSAPP_CUSTOMER_TEMPLATE_LANG=en
# WHATSAPP_WEBHOOK_URL=

# Email: none | log | resend | webhook
# NOTIFY_EMAIL_PROVIDER=none
# RESEND_API_KEY=
# EMAIL_WEBHOOK_URL=

# SMS: none | log | twilio | webhook
# NOTIFY_SMS_PROVIDER=none
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# SMS_WEBHOOK_URL=
# NOTIFY_WEBHOOK_SECRET=

# Media storage. Default is local filesystem (./media, Docker volume on the VPS).
# MEDIA_STORAGE=local
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true
# S3_PREFIX=media
